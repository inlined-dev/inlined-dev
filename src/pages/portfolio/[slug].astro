---
import { getProjects } from "../../lib/content";

// Entries used to have a page each. They now live on /portfolio under an
// anchor, so the old URLs forward there.
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { title: project.data.title } }));
}

const { slug } = Astro.params;
const { title } = Astro.props;
const target = `/portfolio#${slug}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL("/portfolio", Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p><a href={target}>{title} is on the portfolio page.</a></p>
  </body>
</html>
