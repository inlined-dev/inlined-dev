---
import Base from "../layouts/Base.astro";
import { Content as Bio } from "../content/bio.md";
import { getPosts, getProjects, getTalks, talkHref, formatDate, formatTalkDate, isoDate } from "../lib/content";

const posts = (await getPosts()).slice(0, 3);
const projects = (await getProjects()).slice(0, 3);
const talks = (await getTalks()).slice(0, 3);

const links = [
  { label: "github/inlined", href: "https://github.com/inlined" },
  { label: "bsky/inlined.dev", href: "https://bsky.app/profile/inlined.dev" },
  { label: "linkedin/thomasbouldin", href: "https://www.linkedin.com/in/thomasbouldin/" },
  { label: "threads/@inlined", href: "https://threads.net/@inlined" },
  { label: "x/@inlined", href: "https://twitter.com/inlined" },
  { label: "instagram/@inlined", href: "https://instagram.com/inlined" },
  { label: "facebook/inlined", href: "https://facebook.com/inlined" },
];
---

<Base title="inlined.dev">
  <div class="home">
    <section class="hero" aria-labelledby="name">
      <p class="prompt">whoami</p>
      <h1 id="name">Thomas Bouldin<span class="cursor">_</span></h1>
      <p class="prompt">cat bio.md</p>
      <div class="bio prose">
        <Bio />
      </div>
    </section>

    <section aria-labelledby="links">
      <p class="prompt" id="links">ls ~/links</p>
      <ul class="links">
        {links.map((link) => (
          <li><a href={link.href} rel="me">{link.label}</a></li>
        ))}
      </ul>
    </section>

    <div class="panels">
      <section class="panel" aria-labelledby="latest">
        <h2 id="latest">tail -n 3 blog/</h2>
        {posts.length > 0 ? (
          <ul class="entry-list">
            {posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
                <span class="meta">
                  <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time> · {post.data.summary}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">blog/: no posts yet</p>
        )}
        <a class="more" href="/blog">all posts</a>
      </section>

      <section class="panel" aria-labelledby="work">
        <h2 id="work">ls -t portfolio/ | head -3</h2>
        {projects.length > 0 ? (
          <ul class="entry-list">
            {projects.map((project) => (
              <li>
                <a href={`/portfolio/${project.id}`}>{project.data.title}</a>
                <span class="meta">
                  {project.data.role && <>{project.data.role} · </>}{project.data.summary}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">portfolio/: nothing here yet</p>
        )}
        <a class="more" href="/portfolio">everything</a>
      </section>

      <section class="panel" aria-labelledby="speaking">
        <h2 id="speaking">ls -lt talks/ | head -3</h2>
        {talks.length > 0 ? (
          <ul class="entry-list">
            {talks.map((talk) => (
              <li>
                <a href={talkHref(talk) ?? "/talks"}>{talk.data.title}</a>
                <span class="meta">
                  {talk.data.event} · <time datetime={isoDate(talk.data.date)}>{formatTalkDate(talk)}</time>
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">talks/: nothing here yet</p>
        )}
        <a class="more" href="/talks">all talks</a>
      </section>
    </div>
  </div>
</Base>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-top: 16px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .bio {
    max-width: 720px;
  }

  .bio :global(p:first-child) {
    color: var(--fg);
  }

  .links {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
</style>
