---
import Base from "../layouts/Base.astro";
import { experimental_AstroContainer as AstroContainer } from "astro/container";
import { Content as Resume, frontmatter } from "../content/resume.md";
import { splitResumeHeadings } from "../lib/resume-headings";
import shortLinks from "../data/short-links.json";

const container = await AstroContainer.create();
const rendered = splitResumeHeadings(await container.renderToString(Resume));

// Print footnotes: number each link in the body and list its (short) address at the bottom.
const display = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const shortFor = new Map(Object.entries(shortLinks).map(([slug, url]) => [url, `inlined.dev/r/${slug}`]));
const notes: { href: string; label: string }[] = [];
const body = rendered.replace(/<a href="([^"]+)"([^>]*)>(.*?)<\/a>/g, (whole, href: string, rest: string, text: string) => {
  const url = href.replace(/&amp;/g, "&");
  // A link whose own text already shows the address needs no footnote.
  if (text.includes(display(url))) return whole;
  let n = notes.findIndex((note) => note.href === url) + 1;
  if (!n) n = notes.push({ href: url, label: shortFor.get(url) ?? display(url) });
  return `${whole}<sup class="fn">[${n}]</sup>`;
});

const { candidate, summary, location, email, website, github, linkedin } = frontmatter;
const contacts = [
  location && { label: location },
  website && { label: display(website), href: website },
  email && { label: email, href: `mailto:${email}` },
  github && { label: display(github), href: github },
  linkedin && { label: display(linkedin), href: linkedin },
].filter(Boolean) as { label: string; href?: string }[];
---

<Base title="Resume" description={`Resume of ${candidate}. ${summary ?? ""}`.trim()}>
  <div class="resume">
    <div class="actions no-print">
      <p class="prompt">cat resume.md</p>
      <ul class="chips" aria-label="Other formats">
        <li><a href="/resume.pdf">download .pdf</a></li>
        <li><a href="/resume.md">raw .md</a></li>
      </ul>
    </div>
    <article class="resume-doc prose">
      <header class="resume-head">
        <div class="who">
          <h1>{candidate}</h1>
          {summary && <p class="headline">{summary}</p>}
        </div>
        <ul class="contact" aria-label="Contact">
          {contacts.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>)}
        </ul>
      </header>
      <div class="resume-main"><Fragment set:html={body} /></div>
      {notes.length > 0 && (
        <footer class="footnotes">
          <h2>Links</h2>
          <ol>
            {notes.map((note) => <li><span class="num">{notes.indexOf(note) + 1}</span>{note.label}</li>)}
          </ol>
        </footer>
      )}
    </article>
  </div>
</Base>

<style>
  /* Static (non-variable) instances for the PDF: Chromium embeds variable fonts as Type 3,
     which some resume parsers and PDF viewers handle badly. */
  @font-face {
    font-family: "Inter Print";
    font-style: normal;
    font-weight: 400;
    src: url("/fonts/Inter-static-400.woff2") format("woff2");
  }

  @font-face {
    font-family: "Inter Print";
    font-style: normal;
    font-weight: 500;
    src: url("/fonts/Inter-static-500.woff2") format("woff2");
  }

  @font-face {
    font-family: "Inter Print";
    font-style: normal;
    font-weight: 600;
    src: url("/fonts/Inter-static-600.woff2") format("woff2");
  }

  @font-face {
    font-family: "Inter Print";
    font-style: normal;
    font-weight: 650;
    src: url("/fonts/Inter-static-650.woff2") format("woff2");
  }

  .resume {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* ---------- Screen: terminal theme ---------- */

  .resume-doc {
    max-width: 860px;
  }

  .resume-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 32px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: 8px;
  }

  .resume-head h1 {
    margin: 0;
    font-size: clamp(28px, 5vw, 40px);
  }

  .headline {
    margin: 8px 0 0;
    max-width: 52ch;
    color: var(--fg-soft);
  }

  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
  }

  .resume-doc :global(.entry-head) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px 16px;
  }

  /* Keep the "### " prompt inside the label so it doesn't become a third flex item. */
  .resume-doc :global(h3.entry-head::before) {
    content: none;
  }

  .resume-doc :global(h3.entry-head .label::before) {
    content: "### ";
    color: var(--prompt);
  }

  .resume-doc :global(.entry-head .role) {
    margin-left: 0;
    font-weight: 400;
    color: var(--fg-soft);
  }

  /* Visible separator between organization and role (the markdown's " · "). */
  .resume-doc :global(.entry-head .role::before) {
    content: "·";
    margin: 0 0.5em;
  }

  .resume-doc :global(.entry-head .dates) {
    font-weight: 400;
    font-size: 14px;
    color: var(--muted);
    white-space: nowrap;
  }

  .resume-doc :global(h4) {
    margin: 20px 0 8px;
    font-size: 15px;
  }

  .resume-doc :global(h2 a) {
    margin-left: 8px;
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }

  .resume-doc :global(h2 a:hover) {
    color: var(--accent-hover);
  }

  .footnotes,
  .resume-doc :global(sup.fn) {
    display: none;
  }

  /* ---------- Print: two-page resume layout ---------- */

  @media print {
    @page {
      size: Letter;
      margin: 0.55in 0.6in 0.5in;
    }

    .resume {
      gap: 0;
    }

    .resume-doc {
      --ink: #16181d;
      --soft: #3b4049;
      --dim: #6b7280;
      --rule: #d9dce1;
      --accent: #1f4e8c;
      max-width: none;
      font-family: "Inter Print", "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 9.6pt;
      line-height: 1.42;
      color: var(--ink);
      font-feature-settings: "tnum" 1, "cv11" 1, "liga" 0, "clig" 0, "calt" 0;
      font-variant-ligatures: none;
      text-rendering: optimizeSpeed;
    }

    .resume-doc :global(a) {
      color: inherit;
      text-decoration: none;
    }

    .resume-doc :global(li a),
    .resume-doc :global(p a) {
      text-decoration: underline;
      text-decoration-color: var(--rule);
      text-underline-offset: 2pt;
    }

    .resume-head {
      flex-wrap: nowrap;
      gap: 24pt;
      padding-bottom: 8pt;
      margin-bottom: 0;
      border-bottom: 1.5pt solid var(--accent);
    }

    .resume-head h1 {
      font-size: 23pt;
      font-weight: 650;
      letter-spacing: 0;
      line-height: 1.05;
      color: var(--ink);
    }

    .headline {
      margin-top: 3pt;
      max-width: none;
      font-size: 10pt;
      color: var(--soft);
    }

    .contact {
      flex-shrink: 0;
      display: grid;
      grid-template-columns: repeat(2, auto);
      column-gap: 14pt;
      row-gap: 1pt;
      font-size: 8.8pt;
      text-align: right;
      color: var(--soft);
    }

    .contact a {
      text-decoration: none !important;
    }

    .resume-doc :global(h2) {
      margin: 20pt 0 5pt;
      padding: 0;
      border: 0;
      font-size: 8.4pt;
      font-weight: 650;
      letter-spacing: 0.14em;
      font-kerning: none;
      text-transform: uppercase;
      color: var(--accent);
      break-after: avoid;
    }

    .resume-head + :global(h2) {
      margin-top: 9pt;
    }

    .resume-doc :global(h2 a) {
      margin-left: 4pt;
      text-transform: none;
      letter-spacing: 0;
      font-weight: 400;
      color: var(--dim);
      text-decoration: none;
    }

    .resume-doc :global(h2::before),
    .resume-doc :global(h3::before),
    .resume-doc :global(h3.entry-head .label::before) {
      content: none;
    }

    .resume-doc :global(h3),
    .resume-doc :global(h4) {
      display: flex;
      flex-wrap: nowrap;
      justify-content: space-between;
      align-items: baseline;
      gap: 12pt;
      margin: 0;
      color: var(--ink);
      break-after: avoid;
    }

    .resume-doc :global(h3) {
      margin-top: 16pt;
      font-size: 10.6pt;
      font-weight: 650;
    }

    .resume-doc :global(h2 + h3) {
      margin-top: 2pt;
    }

    .resume-doc :global(h4) {
      margin-top: 11pt;
      font-size: 9.6pt;
      font-weight: 600;
    }

    .resume-doc :global(h3 + h4) {
      margin-top: 2pt;
    }

    .resume-doc :global(.entry-head .role) {
      margin-left: 0;
      font-weight: 400;
      color: var(--dim);
    }

    .resume-doc :global(h4 .org) {
      color: var(--dim);
      font-weight: 500;
    }

    .resume-doc :global(h4 .role) {
      color: var(--ink);
      font-weight: 600;
    }

    .resume-doc :global(.entry-head .dates) {
      font-size: 9pt;
      font-weight: 400;
      color: var(--dim);
    }

    /* Top-level resume items are plain paragraphs; sub-points are a list beneath. */
    .resume-doc :global(p) {
      margin: 4pt 0 0;
      color: var(--ink);
    }

    .resume-doc :global(h2 + p),
    .resume-doc :global(h3 + p),
    .resume-doc :global(h4 + p) {
      margin-top: 2pt;
    }

    /* Footnote markers and the "Links" list, pinned to the bottom of the last page. */
    .resume-doc :global(sup.fn) {
      display: inline;
      margin-left: 1pt;
      font-size: 6.5pt;
      line-height: 0;
      vertical-align: baseline;
      color: var(--accent);
    }

    .resume-doc {
      display: flex;
      flex-direction: column;
      /* Just under two Letter pages of content area, so the footer sits at the foot of page 2. */
      min-height: 19.3in;
    }

    .footnotes {
      display: block;
      margin-top: auto;
      padding-top: 6pt;
      border-top: 0.5pt solid var(--rule);
      break-inside: avoid;
    }

    .footnotes :global(h2),
    .resume-doc .footnotes h2 {
      margin: 0 0 3pt;
    }

    .footnotes ol {
      list-style: none;
      margin: 0;
      padding: 0;
      columns: 3;
      column-gap: 16pt;
      font-size: 8.2pt;
      line-height: 1.5;
      color: var(--soft);
    }

    .footnotes li {
      break-inside: avoid;
    }

    .footnotes .num {
      display: inline-block;
      width: 12pt;
      color: var(--accent);
      font-weight: 600;
    }

    .resume-doc :global(strong) {
      font-weight: 600;
      color: var(--ink);
    }

    .resume-doc :global(ul:not(.contact)) {
      list-style: none;
      margin: 1pt 0 0;
      padding: 0;
      color: var(--soft);
    }

    /* No position: relative/absolute here: positioned boxes paint later, which scrambles the
       PDF's text order for parsers and copy/paste. The dash is an inline hanging marker instead. */
    .resume-doc :global(ul:not(.contact) > li) {
      margin: 1pt 0 0;
      padding-left: 11pt;
      break-inside: avoid;
    }

    .resume-doc :global(ul:not(.contact) > li::before) {
      content: "– ";
      display: inline-block;
      width: 11pt;
      margin-left: -11pt;
      color: var(--dim);
    }
  }
</style>
