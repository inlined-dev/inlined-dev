---
import Base from "../../layouts/Base.astro";
import Presenters from "../../components/Presenters.astro";
import { getTalks, groupTalksByYear, talkHref, talkEvent, hasWriteup, formatTalkDate, isoDate } from "../../lib/content";

const talks = await getTalks();
const years = groupTalksByYear(talks);
---

<Base title="Talks" description="Conference talks and meetups by Thomas Bouldin.">
  <div class="index">
    <p class="prompt">ls -lt talks/</p>
    <h1>Talks</h1>
    {years.length > 0 ? (
      years.map(([year, group]) => (
        <section class="year" aria-labelledby={`y${year}`}>
          <h2 id={`y${year}`}>{year}</h2>
          <ul class="listing">
            {group.map((talk) => {
              const href = talkHref(talk);
              return (
                <li>
                  <time datetime={isoDate(talk.data.date)}>{formatTalkDate(talk)}</time>
                  <div class="entry">
                    {href ? <a href={href}>{talkEvent(talk)}</a> : <span class="title">{talkEvent(talk)}</span>}
                    <span class="session">{talk.data.title}</span>
                    {(talk.data.location || talk.data.with.length > 0) && (
                      <span class="meta">
                        {talk.data.location}
                        {talk.data.location && talk.data.with.length > 0 && " · "}
                        <Presenters people={talk.data.with} />
                      </span>
                    )}
                    {talk.data.summary && <span class="meta">{talk.data.summary}</span>}
                    <span class="links">
                      {hasWriteup(talk) && <a href={`/talks/${talk.id}`}>notes</a>}
                      {talk.data.video && <a href={talk.data.video}>video ↗</a>}
                      {talk.data.slides && <a href={talk.data.slides}>slides ↗</a>}
                      {talk.data.url && <a href={talk.data.url}>event page ↗</a>}
                    </span>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    ) : (
      <p class="empty">talks/: nothing here yet</p>
    )}
  </div>
</Base>

<style>
  .index {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h1 {
    margin: 0;
    font-size: 36px;
  }

  .year {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 16px;
  }

  .year h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
  }

  .year h2::before {
    content: "# ";
    color: var(--prompt);
  }

  .title {
    color: var(--fg-strong);
    font-weight: 500;
    font-size: 17px;
  }

  .session {
    color: var(--fg);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 4px;
    font-size: 13px;
  }

  /* Beat the listing's title-link style, which would otherwise apply here too. */
  .entry .links a {
    font-size: 13px;
    font-weight: 400;
    color: var(--accent);
  }
</style>
